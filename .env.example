# Αντίγραψέ το σε .env (ΔΕΝ μπαίνει στο git) και συμπλήρωσε. Βλ. docs/deploy.md.

# --- Πρόσβαση -------------------------------------------------------------
# Τοπικό VM: η IP (ή το όνομα στο LAN) του VM + CADDY_TLS=internal
# Δημόσιο αργότερα: το domain + ένα email για Let's Encrypt στο CADDY_TLS
DOMAIN=192.168.1.61
CADDY_TLS=internal

# --- Email (προαιρετικό) --------------------------------------------------
# Προσκλήσεις, επαναφορά κωδικού, επιβεβαίωση εγγραφής — STARTTLS (π.χ. ένας
# λογαριασμός Gmail με «κωδικό εφαρμογής»: smtp.gmail.com / 587).
# Κενό MISEVENT_SMTP_HOST: οι σύνδεσμοι φαίνονται μόνο στην οθόνη και η εγγραφή
# ΔΕΝ επιβεβαιώνει email — αρκετό για δοκιμές στο LAN.
MISEVENT_SMTP_HOST=
MISEVENT_SMTP_PORT=587
MISEVENT_SMTP_USER=
MISEVENT_SMTP_PASSWORD=
MISEVENT_SMTP_FROM=
