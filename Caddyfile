# DOMAIN    : IP ή όνομα του VM στο LAN (π.χ. 192.168.1.50 / misevent.lan),
#             ή δημόσιο domain αργότερα.
# CADDY_TLS : "internal" = πιστοποιητικό από τοπική CA του Caddy (LAN, χωρίς
#             internet)· ένα email = Let's Encrypt (δημόσιο domain, θύρες 80/443 ανοιχτές).
# ⚠️ ΚΑΝΕΝΑ HSTS εδώ: με τοπικό πιστοποιητικό θα κλείδωνε τον browser έξω.
#    Πρόσθεσέ το όταν περάσεις σε δημόσιο domain:
#    header Strict-Transport-Security "max-age=31536000"
{$DOMAIN} {
	tls {$CADDY_TLS}
	reverse_proxy app:8000
}
